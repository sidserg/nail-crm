# ====== Nail CRM configuration ======
# Copy to .env and fill in:  cp .env.example .env

# Your domain (A-record must point to this VPS). Caddy will get HTTPS certificates automatically.
# Leave ":80" for a first test over plain HTTP by IP.
DOMAIN=crm.example.com

# Salon timezone — ALL times in the app are wall-clock times of this zone
TZ=Europe/Moscow

# --- Database ---
POSTGRES_DB=nailcrm
POSTGRES_USER=nailcrm
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Auth ---
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_random_64_hex_chars
OWNER_LOGIN=admin
# First-launch password. CHANGE IT right after first login (Settings → Security)!
OWNER_PASSWORD=CHANGE_ME_owner_password

# --- Telegram bot (optional but recommended) ---
# 1) Create a bot via @BotFather → paste the token here
# 2) Get your chat id via @userinfobot → paste below (owner notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- Backups ---
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# Optional S3-compatible storage (AWS, Selectel, Yandex Object Storage, VK Cloud, MinIO…).
# If S3_BUCKET is empty, backups stay local in ./backups only.
S3_BUCKET=
S3_ENDPOINT=
S3_PREFIX=nailcrm
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
